{
  "name": "textracer-backend",
  "version": "1.0.0",
  "private": true,
  "description": "TexTracer REST API (Node.js + TypeScript on a local PostgreSQL database; Supabase optional via DB_MODE=cloud)",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "test:watch": "node --import tsx --test --watch \"tests/**/*.test.ts\"",
    "test:local": "node --import tsx --test tests/local.db.test.ts",
    "db:init": "node ../database/local/init-local-db.mjs",
    "db:init:test": "node ../database/local/init-local-db.mjs --db textracer_test",
    "db:reset": "node ../database/local/init-local-db.mjs --reset --yes",
    "db:check": "tsx src/db/check.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "pg": "^8.13.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.8.3"
  }
}
